---
import ContactForm from './ContactForm.astro';
import Icons from './Icons.astro';
import { whatsappUrl, social } from '../config/site.ts';
import { school } from '../config/school.ts';
---

<section id="contacto" class="section section--cream contact" aria-labelledby="contacto-title">
  <div class="container contact__grid">
    <div class="contact__intro" data-reveal>
      <p class="eyebrow">Contacto e inscripción</p>
      <h2 id="contacto-title" class="display h2">Contactá a Pura Potencia</h2>
      <p class="lead" style="margin-top: 1.5rem">
        Escribinos y te contamos sobre entrenamientos, horarios e inscripción en Pura Potencia.
      </p>
      <ul class="contact__channels">
        {whatsappUrl && (
          <li>
            <a class="btn btn--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <Icons name="whatsapp" /> Escribinos por WhatsApp <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </li>
        )}
        <li>
          <a class="btn btn--outline btn--outline-dark" href={social.instagramUrl} target="_blank" rel="noopener noreferrer">
            <Icons name="instagram" /> Seguinos en Instagram <span class="sr-only">{social.instagramHandle} (se abre en una pestaña nueva)</span>
          </a>
        </li>
      </ul>
      {school.address?.openToPublic && (
        <p class="contact__address">
          <strong>Dónde estamos:</strong> {school.address.street}, {school.address.locality}
        </p>
      )}
    </div>

    <div class="contact__form-panel" data-reveal>
      <h3 class="display h3">¿Tenés una consulta específica?</h3>
      <p>Si preferís, dejá tus datos y contanos qué necesitás saber.</p>
      <div class="contact__form"><ContactForm /></div>
    </div>
  </div>
</section>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; align-items: start; }
  .contact__channels { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }
  .contact__address { margin-top: 2rem; }
  .contact__form-panel { background: var(--cream-2); border: 2px solid var(--ink); padding: clamp(1.25rem, 4vw, 2.5rem); box-shadow: 8px 8px 0 var(--deep); }
  .contact__form-panel > p { margin-top: 0.5rem; }
  .contact__form { margin-top: 1.5rem; }
  @media (min-width: 62rem) {
    .contact__grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 3rem; }
    .contact__intro { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>

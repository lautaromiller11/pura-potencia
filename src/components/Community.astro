---
import Photo from './Photo.astro';
import { photos } from '../config/images.ts';
---

<section id="comunidad" class="section section--deep on-dark community" aria-labelledby="comunidad-title">
  <span class="community__circle" aria-hidden="true"></span>
  <div class="container community__grid">
    <div data-reveal>
      <p class="eyebrow">Comunidad</p>
      <h2 id="comunidad-title" class="display h2">Una escuela para formar parte</h2>
      <p class="community__quote display">Para las que juegan con el corazón</p>
      <div class="prose">
        <p>
          El fútbol también es compartir la cancha, aprender de las demás y crecer en equipo.
          En una escuela de fútbol femenino como Pura Potencia, cada entrenamiento suma a algo más grande que un partido.
        </p>
        <p><strong>Hay un lugar para vos:</strong> para jugar, para aprender y para ser parte.</p>
      </div>
    </div>
    <div class="community__photos" data-reveal>
      <div class="community__photo community__photo--main">
        <Photo photo={photos.community} ratio="1 / 1" sizes="(min-width: 62rem) 26rem, 88vw" />
      </div>
      <div class="community__photo community__photo--overlap">
        <Photo photo={photos.aboutMain} ratio="4 / 3" sizes="(min-width: 62rem) 17rem, 58vw" />
      </div>
    </div>
  </div>
</section>

<style>
  .community__circle {
    position: absolute; right: -14rem; top: -10rem; width: 34rem; aspect-ratio: 1; border-radius: 50%;
    border: 3px solid rgba(167, 184, 169, 0.28); pointer-events: none;
  }
  .community__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 3rem; align-items: center; }
  .community__quote { margin: 2rem 0; font-size: clamp(2rem, 6vw, 3.5rem); color: var(--mist); font-weight: 700; line-height: 0.95; }
  .community__photos { position: relative; width: min(100%, 34rem); padding-right: 7%; padding-bottom: clamp(7rem, 22vw, 9rem); }
  .community__photo { overflow: hidden; }
  .community__photo--main { width: 100%; }
  .community__photo--overlap { position: absolute; right: 0; bottom: -1.25rem; width: 74%; border: 7px solid var(--deep); }
  @media (min-width: 62rem) {
    .community__grid { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; }
    .community__photos { justify-self: end; }
  }
</style>

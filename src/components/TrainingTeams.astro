---
import { trainingTeams } from '../config/teams.ts';

const hasTeams = trainingTeams.length > 0;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section id="equipos" class="section section--deep teams" aria-labelledby="teams-title">
  <div class="container">
    <header class="teams__head" data-reveal>
      <p class="eyebrow">Nuestra comunidad</p>
      <h2 id="teams-title" class="display h2">Entrenan con nosotras</h2>
      <p class="lead">Detrás de cada equipo hay una historia, una pasión compartida y muchas horas de cancha. Conocé a quienes entrenan con nosotras.</p>
    </header>

    {hasTeams ? (
      <div class="teams__carousel" data-teams-carousel aria-roledescription="carrusel" aria-label="Equipos que entrenan con nosotras" tabindex="0" data-reveal>
        <div class="teams__track" data-teams-track>
          {trainingTeams.map((team, index) => (
            <article class="teams__card" data-team-card aria-label={`${index + 1} de ${trainingTeams.length}`}>
              <div class="teams__image">
                {team.image ? (
                  <img src={`${base}${team.image.replace(/^\/+/, '')}`} alt={team.alt ?? `Equipo ${team.name}`} loading="lazy" width="1440" height="960" />
                ) : (
                  <div class="teams__placeholder" role="img" aria-label="Espacio reservado para la foto del equipo">
                    <span class="teams__field" aria-hidden="true"></span>
                    <span class="teams__placeholder-label">Foto del equipo<br /><small>Agregar en public/images/equipos/</small></span>
                  </div>
                )}
              </div>
              <div class="teams__content">
                <p class="teams__eyebrow">{team.isExample ? 'Ejemplo ficticio · reemplazar' : 'Equipo invitado'}</p>
                <h3 class="display h3">{team.name}</h3>
                <p class="teams__description">{team.description}</p>
                {team.since && <p class="teams__since">Entrenan con nosotras desde <strong>{team.since}</strong></p>}
                {team.achievements?.length ? (
                  <ul class="teams__achievements" aria-label="Logros deportivos">
                    {team.achievements.map((achievement) => <li>{achievement}</li>)}
                  </ul>
                ) : null}
              </div>
            </article>
          ))}
        </div>
        {trainingTeams.length > 1 && (
          <div class="teams__controls" aria-label="Controles del carrusel">
            <button type="button" class="teams__arrow" data-team-prev aria-label="Ver equipo anterior"><span aria-hidden="true">←</span></button>
            <p class="teams__count" aria-live="polite" aria-atomic="true"><span data-team-current>1</span> <span aria-hidden="true">de</span> <span class="sr-only">de </span>{trainingTeams.length}</p>
            <button type="button" class="teams__arrow" data-team-next aria-label="Ver equipo siguiente"><span aria-hidden="true">→</span></button>
          </div>
        )}
      </div>
    ) : (
      <p class="teams__empty">Pronto vas a conocer a los equipos que entrenan con nosotras.</p>
    )}
  </div>
</section>

<style>
  .teams__head { max-width: 54rem; }
  .teams__head .lead { margin-top: 1rem; }
  .teams__carousel { margin-top: clamp(2rem, 5vw, 3.5rem); }
  .teams__track { display: grid; grid-template-columns: minmax(0, 1fr); }
  .teams__card { display: grid; grid-template-columns: minmax(0, 1fr); min-height: 29rem; background: var(--cream); color: var(--ink); border: 2px solid var(--ink); }
  .teams__image { aspect-ratio: 3 / 2; min-height: 14rem; overflow: hidden; background: var(--sage); }
  .teams__image img { width: 100%; height: 100%; object-fit: cover; }
  .teams__placeholder { position: relative; display: grid; place-items: center; width: 100%; height: 100%; min-height: 14rem; overflow: hidden; background: repeating-linear-gradient(90deg, rgba(17,24,21,.1) 0 2.25rem, transparent 2.25rem 4.5rem), var(--sage); }
  .teams__field { position: absolute; inset: 12%; border: 2px solid rgba(243,235,215,.65); }
  .teams__field::before { content: ''; position: absolute; inset: 0 50%; border-left: 2px solid rgba(243,235,215,.65); }
  .teams__field::after { content: ''; position: absolute; width: 28%; aspect-ratio: 1; left: 50%; top: 50%; transform: translate(-50%,-50%); border: 2px solid rgba(243,235,215,.65); border-radius: 50%; }
  .teams__placeholder-label { z-index: 1; padding: .6rem .8rem; background: var(--ink); color: var(--cream); text-align: center; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; line-height: 1.2; text-transform: uppercase; }
  .teams__placeholder-label small { font-family: var(--font-body); font-size: .72rem; font-weight: 500; text-transform: none; }
  .teams__content { display: flex; flex-direction: column; align-items: flex-start; padding: clamp(1.25rem, 4vw, 2.5rem); }
  .teams__eyebrow { margin-bottom: .6rem; color: var(--deep); font-family: var(--font-display); font-weight: 700; font-size: .9rem; letter-spacing: .1em; text-transform: uppercase; }
  .teams__content h3 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .teams__description { margin-top: 1rem; max-width: 38rem; }
  .teams__since { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid rgba(17,24,21,.2); }
  .teams__achievements { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .teams__achievements li { padding: .35rem .65rem; background: var(--mist); color: var(--ink); font-size: .9rem; font-weight: 700; }
  .teams__controls { display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-top: 1.25rem; }
  .teams__arrow { display: grid; place-items: center; width: 3rem; height: 3rem; border: 2px solid var(--cream); border-radius: 50%; background: transparent; color: var(--cream); cursor: pointer; font-size: 1.5rem; }
  .teams__arrow:hover { background: var(--cream); color: var(--ink); }
  .teams__count { min-width: 4rem; text-align: center; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .teams__empty { margin-top: 2rem; padding: 2rem; background: var(--cream); color: var(--ink); }
  @media (min-width: 52rem) {
    .teams__card { grid-template-columns: 1.08fr .92fr; min-height: 27rem; }
    .teams__image { aspect-ratio: auto; min-height: 27rem; }
    .teams__content { justify-content: center; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .teams__card { animation: teams-enter .22s ease-out; }
    @keyframes teams-enter { from { opacity: .7; } to { opacity: 1; } }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-teams-carousel]');
  if (carousel) {
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>('[data-team-card]'));
    const current = carousel.querySelector<HTMLElement>('[data-team-current]');
    const previous = carousel.querySelector<HTMLButtonElement>('[data-team-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-team-next]');
    let active = 0;
    const show = (index: number) => {
      active = (index + cards.length) % cards.length;
      cards.forEach((card, i) => {
        card.hidden = i !== active;
        card.setAttribute('aria-hidden', String(i !== active));
      });
      if (current) current.textContent = String(active + 1);
    };
    if (cards.length > 1) {
      show(0);
      previous?.addEventListener('click', () => show(active - 1));
      next?.addEventListener('click', () => show(active + 1));
      carousel.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); show(active - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); show(active + 1); }
      });
      let touchStart: number | null = null;
      carousel.addEventListener('touchstart', (event) => { touchStart = event.changedTouches[0]?.clientX ?? null; }, { passive: true });
      carousel.addEventListener('touchend', (event) => {
        const end = event.changedTouches[0]?.clientX;
        if (touchStart !== null && end !== undefined && Math.abs(end - touchStart) > 48) show(active + (end < touchStart ? 1 : -1));
        touchStart = null;
      }, { passive: true });
    }
  }
</script>

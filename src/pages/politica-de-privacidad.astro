---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { school, privacyIsComplete } from '../config/school.ts';

const p = school.privacy;
const base = import.meta.env.BASE_URL;
const pending = (v: string | null, hint: string) => v ?? `[A completar por la escuela: ${hint}]`;
---

<Base
  title={`Política de privacidad | ${school.name}`}
  description="Cómo trata Pura Potencia los datos personales que se envían a través del formulario de contacto."
  path="/politica-de-privacidad"
  noindex={!privacyIsComplete}
>
  <header class="legal-header">
    <div class="container"><a href={base} aria-label="Volver al inicio de Pura Potencia"><Logo /></a></div>
  </header>
  <main id="contenido" class="section section--cream">
    <article class="container legal">
      <h1 class="display h2">Política de privacidad</h1>
      {!privacyIsComplete && (
        <p class="legal__draft" role="note">
          <strong>Borrador pendiente de completar.</strong> Faltan datos del responsable. Completar en <code>src/config/school.ts</code> y revisar el texto con un profesional antes de publicar.
        </p>
      )}
      <p><strong>Última actualización:</strong> {pending(p.lastUpdated, 'fecha')}</p>

      <h2>1. Responsable del tratamiento</h2>
      <p>
        {pending(p.controller, 'nombre o razón social del responsable')}
        {p.controllerTaxId && <> (CUIT/CUIL: {p.controllerTaxId})</>}.
        Correo para consultas sobre tus datos: {pending(p.contactEmail, 'correo de contacto')}.
      </p>

      <h2>2. Qué datos recopilamos</h2>
      <p>A través del formulario de contacto de este sitio recibimos únicamente los datos que vos nos enviás:</p>
      <ul>
        <li>Nombre y apellido.</li>
        <li>Correo electrónico.</li>
        <li>Teléfono o WhatsApp (opcional).</li>
        <li>Motivo de consulta (opcional) y mensaje.</li>
        <li>La aceptación de esta política.</li>
      </ul>
      <p>No te pedimos datos sensibles. Te pedimos que no los incluyas en el mensaje.</p>

      <h2>3. Para qué los usamos</h2>
      <p>Usamos estos datos únicamente para responder tu consulta sobre {school.name}, sus entrenamientos o su inscripción.</p>

      <h2>4. Con quién se comparten (proveedores)</h2>
      <ul>
        <li><strong>Resend</strong>: servicio de envío de correo electrónico que transmite tu consulta a la casilla de la escuela.</li>
        <li><strong>Proveedor de alojamiento del sitio</strong> (Vercel u otro que se utilice): procesa la solicitud técnica del formulario y puede registrar datos técnicos como la dirección IP.</li>
      </ul>
      <p>Estos proveedores pueden ubicarse fuera de Argentina. No vendemos tus datos ni los usamos para publicidad.</p>

      <h2>5. Cuánto tiempo los conservamos</h2>
      <p>
        Este sitio no guarda las consultas en una base de datos: el mensaje llega por correo a la escuela.
        {pending(p.retention, 'plazo de conservación de las consultas recibidas por correo')}
      </p>

      <h2>6. Cookies y analítica</h2>
      <p>Este sitio no utiliza cookies de seguimiento ni herramientas de analítica propias.</p>

      <h2>7. Tus derechos</h2>
      <p>
        Podés solicitar el acceso, la rectificación o la supresión de tus datos escribiendo a {pending(p.contactEmail, 'correo de contacto')}.
        La Agencia de Acceso a la Información Pública (AAIP) es el órgano de control de la Ley 25.326 de Protección de Datos Personales y atiende denuncias y reclamos por incumplimientos de esa ley.
      </p>

      <p><a href={base}>← Volver al inicio</a></p>
    </article>
  </main>
</Base>

<style>
  .legal-header { background: var(--cream); border-bottom: 2px solid var(--ink); padding-block: 0.75rem; }
  .legal-header a { text-decoration: none; display: inline-flex; }
  .legal-header :global(.logo-image) { width: 9rem; }
  .legal { max-width: 46rem; }
  .legal :global(h2) { font-family: var(--font-display); text-transform: uppercase; font-size: 1.75rem; letter-spacing: 0.03em; margin: 2.25rem 0 0.5rem; }
  .legal :global(p), .legal :global(ul) { margin-top: 0.75rem; }
  .legal :global(ul) { list-style: disc; padding-left: 1.4rem; }
  .legal :global(h1) { margin-bottom: 1.5rem; }
  .legal__draft { background: #fff3cd; border: 2px solid #7a5b00; padding: 1rem 1.25rem; border-radius: var(--radius); margin-bottom: 1.5rem; }
  code { background: rgba(17, 24, 21, 0.08); padding: 0.1em 0.35em; border-radius: 3px; }
</style>

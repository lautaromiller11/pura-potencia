# ─────────────────────────────────────────────────────────────
# Pura Potencia — variables de entorno
# Copiá este archivo a .env para desarrollo local y completalo.
# NUNCA subas el archivo .env al repositorio.
# En producción se cargan en el panel de Vercel/Netlify (Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Sitio ────────────────────────────────────────────────────
# URL canónica definitiva, con https y sin barra final. Define canonical,
# Open Graph, sitemap.xml, robots.txt y JSON-LD. Mientras esté vacía,
# el sitio se publica con "noindex" para evitar indexar una URL provisoria.
# Ejemplo de formato: https://tu-dominio.com.ar
SITE_URL=

# ── Contacto público (se usan en el build; se publican en la web) ──
# Número de WhatsApp en formato internacional, solo dígitos.
# Argentina móvil: 54 9 + código de área sin 0 + número sin 15.
# Si queda vacío, los botones de WhatsApp no se muestran.
WHATSAPP_NUMBER=

# ── Formulario de contacto (SOLO servidor, nunca se exponen al cliente) ──
# Clave API de Resend (https://resend.com/api-keys). Empieza con "re_".
RESEND_API_KEY=
# Casilla que recibe las consultas. No se publica en la web.
CONTACT_TO_EMAIL=
# Remitente con dominio verificado en Resend. Formato:
#   Pura Potencia Web <consultas@tu-dominio.com.ar>
CONTACT_FROM_EMAIL=
